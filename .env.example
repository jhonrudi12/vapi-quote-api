# Copy to .env for local testing, or set these in the Vercel dashboard
# (Project -> Settings -> Environment Variables). NEVER commit real keys.

# --- Facilitator (pick ONE) ---

# Option A (recommended, Base mainnet): Coinbase CDP facilitator.
# Free keys from https://portal.cdp.coinbase.com/ (sign up -> API Keys).
# First 1,000 settlements/month free, then $0.001 each.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Option B: any other facilitator URL (overrides Option A when set).
# Must support Base mainnet (eip155:8453) for this API's route.
# Examples:
#   https://facilitator.payai.network  (public, no keys, supports eip155:8453)
#   https://x402.org/facilitator       (public, no keys, TESTNETS ONLY — do NOT use for mainnet)
FACILITATOR_URL=

# --- Payment destination (optional) ---
# Defaults to the agent wallet 0x112b5A6c9d94199e264949a0da5AA0eAD1a7324D.
PAY_TO=0x112b5A6c9d94199e264949a0da5AA0eAD1a7324D

# --- Local dev server port (optional) ---
PORT=3000
